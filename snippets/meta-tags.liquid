{%- comment -%}
  Server-rendered SEO + social metadata. One title, one description, one canonical per page.
{%- endcomment -%}
{%- liquid
  assign seo_title = page_title
  assign seo_description = page_description | default: shop.description

  if template.name == 'index'
    assign seo_title = settings.home_seo_title | default: shop.name
    assign seo_description = settings.home_seo_description | default: page_description
  endif

  assign og_type = 'website'
  assign og_alt = shop.name

  if template.name == 'product'
    assign og_type = 'product'
    assign og_image = product.featured_image
    assign og_alt = product.featured_image.alt | default: product.title
  elsif template.name == 'collection' and collection.image
    assign og_image = collection.image
    assign og_alt = collection.image.alt | default: collection.title
  elsif template.name == 'article' and article.image
    assign og_type = 'article'
    assign og_image = article.image
    assign og_alt = article.image.alt | default: article.title
  endif

  if og_image == blank and settings.social_image != blank
    assign og_image = settings.social_image
    assign og_alt = settings.social_image.alt | default: shop.name
  endif

  assign og_image_url = ''
  assign og_image_height = 630
  if og_image != blank
    assign og_image_url = og_image | image_url: width: 1200
    if og_image.aspect_ratio
      assign og_image_height = 1200 | divided_by: og_image.aspect_ratio | round
    endif
  else
    assign og_image_url = 'og-image.png' | asset_url
  endif
  unless og_image_url contains 'https:'
    assign og_image_url = 'https:' | append: og_image_url
  endunless
-%}
<title>{{ seo_title | strip }}{% if current_page > 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless seo_title contains shop.name or template.name == 'index' %} | {{ shop.name }}{% endunless %}</title>
{%- if seo_description != blank %}
<meta name="description" content="{{ seo_description | strip_html | strip_newlines | truncate: 160 | escape }}">
{%- endif %}
<link rel="canonical" href="{{ canonical_url }}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ seo_title | strip | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if seo_description != blank %}
<meta property="og:description" content="{{ seo_description | strip_html | strip_newlines | truncate: 200 | escape }}">
{%- endif %}
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:secure_url" content="{{ og_image_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="{{ og_image_height }}">
<meta property="og:image:alt" content="{{ og_alt | strip_html | escape }}">
{%- if template.name == 'product' %}
<meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html | escape }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | strip | escape }}">
{%- if seo_description != blank %}
<meta name="twitter:description" content="{{ seo_description | strip_html | strip_newlines | truncate: 200 | escape }}">
{%- endif %}
<meta name="twitter:image" content="{{ og_image_url }}">
<meta name="twitter:image:alt" content="{{ og_alt | strip_html | escape }}">
