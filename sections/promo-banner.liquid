<section class="section" aria-labelledby="promo-{{ section.id }}">
  <div class="container">
    <div class="promo">
      <div class="promo-copy">
        <h2 id="promo-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        {%- endif -%}
      </div>
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 900px) 55vw, 100vw', alt: section.settings.image.alt }}
      {%- else -%}
        <img src="{{ 'promo.svg' | asset_url }}" width="1000" height="520" loading="lazy" alt="Illustration of the Apex Wholesalers shopping bag with a smartphone, earbuds and headphones. Add your own photo in the Theme Editor.">
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Promotional banner",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "UPGRADE\nYOUR EVERYDAY." },
    { "type": "text", "id": "text", "label": "Description", "default": "Quality tech, home essentials and more, all in one place." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop All Products" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [ { "name": "Promotional banner" } ]
}
{% endschema %}
