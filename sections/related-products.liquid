{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <section class="section" aria-labelledby="rel-{{ section.id }}">
    <div class="container">
      <div class="section-head"><h2 id="rel-{{ section.id }}">{{ section.settings.heading }}</h2></div>
      <div class="grid">
        {%- for product in recommendations.products -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
    </div>
  </section>
{%- else -%}
  <div class="recs" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"></div>
{%- endif -%}
{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 }
  ]
}
{% endschema %}
