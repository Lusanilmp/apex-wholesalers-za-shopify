{%- if section.blocks.size > 0 -%}
<div class="announcement" role="region" aria-label="Store announcements">
  <ul>
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        <svg class="icon" aria-hidden="true"><use href="#i-{{ block.settings.icon }}"/></svg>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Announcement",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Delivery" }, { "value": "lock", "label": "Lock" }, { "value": "return", "label": "Returns" }, { "value": "shield", "label": "Shield" }, { "value": "headset", "label": "Support" }
        ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Nationwide Shipping" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "icon": "truck", "text": "Nationwide Shipping" } },
      { "type": "item", "settings": { "icon": "lock", "text": "Secure Payments" } },
      { "type": "item", "settings": { "icon": "return", "text": "Easy Returns" } }
    ]
  }
}
{% endschema %}
