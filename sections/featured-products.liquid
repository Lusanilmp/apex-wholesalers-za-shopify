{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections['all']
  endif
  if section.settings.sort == 'newest'
    assign items = col.products | sort: 'created_at' | reverse
  else
    assign items = col.products
  endif
  assign view_all = col.url | default: routes.all_products_collection_url
-%}
<section class="section" aria-labelledby="fp-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.heading != blank -%}<h2 id="fp-{{ section.id }}">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      <a class="link-arrow" href="{{ view_all }}">{{ 'general.view_all' | t }} <svg class="icon" style="width:14px;height:14px" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    {%- if items.size > 0 -%}
    <div class="carousel" data-carousel>
      <button class="carousel-btn prev" type="button" aria-label="Previous products"><svg class="icon" aria-hidden="true"><use href="#i-left"/></svg></button>
      <div class="track" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
        {%- for product in items limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      <button class="carousel-btn next" type="button" aria-label="Next products"><svg class="icon" aria-hidden="true"><use href="#i-right"/></svg></button>
    </div>
    {%- else -%}
      <p>{{ 'general.no_results' | t }}</p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trending Products" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Popular finds people love right now." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Empty = all products." },
    { "type": "select", "id": "sort", "label": "Order", "default": "default", "options": [
      { "value": "default", "label": "Collection order" }, { "value": "newest", "label": "Newest first" }
    ] },
    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 1, "label": "Products to show", "default": 8 }
  ],
  "presets": [ { "name": "Featured products" } ]
}
{% endschema %}
